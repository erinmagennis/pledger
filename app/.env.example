# Not used yet. Fill when wiring live data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TEMPO_RPC_URL=
BASE_RPC_URL=

# Artizen give-back claims (server only unless NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback (service_role JWT), deprecated by Supabase end of 2026:
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated sha256 of lowercased emails whose receipts cannot be claimed (pledge owner)
PLEDGER_EXCLUDED_EMAIL_HASHES=
# EAS records on Base mainnet. Missing = claims stay "pending" record, never blocked.
PLEDGER_ATTESTER_KEY=
PLEDGER_EAS_SCHEMA_UID=
# Optional client-side Base RPC and WalletConnect
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_WC_PROJECT_ID=
# Stripe crypto onramp (card payments, USDC on Base straight to the claimant). Missing = card option hidden / 503.
# Card to Tempo (demo pool) runs only with a test key (sk_test_); a live key answers 503 for it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only secret for the demo faucet log: IPs are stored as HMAC-SHA256 with it. Missing = plain sha256.
PLEDGER_PEPPER=
